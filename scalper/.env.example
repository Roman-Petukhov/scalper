# Скопируйте в .env и заполните. Файл .env не коммитьте.
#
# Ключи Binance создавайте БЕЗ права на вывод средств и с белым списком IP.

# Demo trading (demo.binance.com -> API Management) — для exchange.env: demo
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Боевые ключи — для exchange.env: mainnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram: токен от @BotFather, chat_id можно узнать у @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
