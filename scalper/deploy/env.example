# Скопируйте на сервере: cp env.example .env — и заполните. Файл .env в git не попадает.

# Домен, указывающий на IP сервера. Без домена: localhost (самоподписанный сертификат).
DOMAIN=panel.example.com
PANEL_URL=https://panel.example.com

# Сервер с Tailscale (без домена и Caddy): раскомментируйте — тогда docker compose сам возьмёт нужный файл.
# COMPOSE_FILE=docker-compose.tailscale.yml

# Пароль входа в панель, не короче 10 символов.
PANEL_PASSWORD=

# Секрет подписи сессий: openssl rand -hex 32
SESSION_SECRET=

# Необязательно: уведомления в Telegram (токен от @BotFather и ваш chat id).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Пауза после закрытия свечи перед сканом, секунд.
SCAN_DELAY_S=20

# Необязательно: адрес пинга внешнего монитора (например, бесплатный healthchecks.io: период 4 ч, допуск 1 ч).
# Бот дёргает его после каждого удачного скана; перестал — монитор пришлёт письмо / сообщение в Telegram.
HEARTBEAT_URL=

# Сколько дневных копий базы хранить в data/backups.
BACKUP_DAYS=14

# Необязательно: мост «бот → облако». Раз в сутки бот кладёт в ветку репозитория снимок состояния (сигналы, итоги сделок
# в R, настройки правил, погода рынка; без объёмов, прибыли в $, баланса и ключей) и пересылает в Telegram недельный
# отчёт облачного разбора (reports/latest.md в той же ветке). Репозиторий публичный — снимок видят все.
# Токен GitHub (fine-grained): только этот репозиторий, право Contents: Read and write. Пусто — моста нет.
BRIDGE_GITHUB_TOKEN=
BRIDGE_REPO=Roman-Petukhov/scalper
BRIDGE_BRANCH=bot-state

# Необязательно: демо-ключ CoinGecko для вкладки «Скринер» (бесплатный, coingecko.com → Developer Dashboard).
# Без ключа скринер работает на общем лимите — при частых пересчётах CoinGecko может отвечать 429 и повторять позже.
COINGECKO_API_KEY=
# Вкладка «Тезисы»: ИИ-аналитик с веб-поиском (console.anthropic.com → API Keys).
# Без ключа вкладка показывает только индикаторы. Расход ≈ $1–3 в месяц.
ANTHROPIC_API_KEY=
# THESES_MODEL=claude-opus-5-5
