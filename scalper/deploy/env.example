# Скопируйте на сервере: cp env.example .env — и заполните. Файл .env в git не попадает.

# Домен, указывающий на IP сервера. Без домена: localhost (самоподписанный сертификат).
DOMAIN=panel.example.com
PANEL_URL=https://panel.example.com

# Пароль входа в панель, не короче 10 символов.
PANEL_PASSWORD=

# Секрет подписи сессий: openssl rand -hex 32
SESSION_SECRET=

# Необязательно: уведомления в Telegram (токен от @BotFather и ваш chat id).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Пауза после закрытия свечи перед сканом, секунд.
SCAN_DELAY_S=20

# Необязательно: адрес пинга внешнего монитора (например, бесплатный healthchecks.io: период 4 ч, допуск 1 ч).
# Бот дёргает его после каждого удачного скана; перестал — монитор пришлёт письмо / сообщение в Telegram.
HEARTBEAT_URL=

# Сколько дневных копий базы хранить в data/backups.
BACKUP_DAYS=14
